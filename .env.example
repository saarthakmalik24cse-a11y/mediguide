# The app works offline with the extractive provider.
LLM_PROVIDER=extractive

# For an OpenAI-compatible API, set provider and credentials:
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MAX_FILE_MB=15
# MEDIGUIDE_DB_PATH=data/mediguide.db
# MEDIGUIDE_INDEX_DIR=data/indexes
# Optional Google sign-in; configure .streamlit/secrets.toml first.
MEDIGUIDE_AUTH_REQUIRED=false
MEDIGUIDE_ADMIN_SUBJECTS=
